# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# Виртуальные окружения
.venv/
venv/
env/
ENV/

# Кэши инструментов
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# ---------------------------------------------------------------------------
# Артефакты проекта — НИКОГДА не коммитим
# ---------------------------------------------------------------------------

# Обученные модели (тяжёлые, воспроизводятся командой `main.py train`)
models/*
!models/.gitkeep

# КАРАНТИН: здесь лежат изолированные ВРЕДОНОСНЫЕ объекты.
# Публикация такого каталога в GitHub — утечка malware-образцов.
quarantine/*
!quarantine/.gitkeep
*.quarantined
.quarantine.key

# Датасеты с образцами (в т.ч. реальный malware)
data/*
!data/README.md

# Отчёты сканирования
reports/*
!reports/.gitkeep

# Логи
*.log
logs/

# ---------------------------------------------------------------------------
# Вредоносные образцы — дополнительная страховка по расширениям
# ---------------------------------------------------------------------------
*.exe
*.dll
*.sys
*.scr
*.bin
*.mal
*.virus
# Исключения: служебные файлы проекта, которые случайно попадают под маски
!**/generate_samples.py

# ---------------------------------------------------------------------------
# IDE / ОС
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/

# Секреты и локальные настройки
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
